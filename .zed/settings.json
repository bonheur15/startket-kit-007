{
	"format_on_save": "on",
	"languages": {
		"TypeScript": {
			"language_servers": ["biome", "typescript-language-server"],
			"formatter": {
				"external": {
					"command": "./node_modules/.bin/biome",
					"arguments": ["format", "--write", "--stdin-file-path={buffer_path}"]
				}
			}
		},
