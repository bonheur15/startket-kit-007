# Backend Engine Environment Variables

# The name of the application
APP_NAME="starterkit-engine"

# The environment the app is running in (development, production)
NODE_ENV="development"

# The host to bind the server to
HOST="0.0.0.0"

# The port to run the server on
PORT="3000"

# CORS origin allowed to access the API (use * for all or specific domains)
CORS_ORIGIN="*"

# Set to "true" to enable global API debug tracing (logs method, path, time, payload, and validation errors)
DEBUG_API="false"

# Database connection string
DATABASE_URL="postgres://postgres:postgres@localhost:5432/starterkit"
