# ─── Web environment ──────────────────────────────────────────────────────────
# Copy to `.env` for local development. Only VITE_* variables reach the browser.

# Base URL of the engine (no trailing slash).
# Leave unset in development: the app then targets port 3000 on the same host
# the page is opened on (localhost or 127.0.0.1), which keeps cookies same-site.
# VITE_API_BASE_URL="http://localhost:3000"
