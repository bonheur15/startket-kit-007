{
	"name": "starterkit-007",
	"private": true,
	"type": "module",
	"workspaces": [
		"engine",
		"web"
	],
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"generate": "bun run --cwd engine generate",
		"dev": "make dev",
		"test": "bun run --cwd engine test",
		"typecheck": "bun run --cwd engine typecheck && bun run --cwd web typecheck",
		"build": "bun run --cwd engine build && bun run --cwd web build",
		"verify": "make verify"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
